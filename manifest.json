{
  "manifest_version": 3,
  "name": "Rose Colored Glasses",
  "version": "0.5.0",
  "description": "Rewrites news headlines into happier versions. Sarcasm slider included.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rose Colored Glasses"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apnews.com/*",
        "https://*.apnews.com/*",
        "https://news.google.com/*",
        "https://*.bbc.com/*",
        "https://*.bbc.co.uk/*",
        "https://*.cnn.com/*",
        "https://*.npr.org/*",
        "https://*.reuters.com/*",
        "https://*.nytimes.com/*",
        "https://*.theguardian.com/*",
        "https://*.washingtonpost.com/*",
        "https://news.yahoo.com/*",
        "https://*.nbcnews.com/*",
        "https://*.foxnews.com/*",
        "https://usatoday.com/*",
        "https://*.usatoday.com/*",
        "https://cbsnews.com/*",
        "https://*.cbsnews.com/*",
        "https://cnbc.com/*",
        "https://*.cnbc.com/*",
        "https://bloomberg.com/*",
        "https://*.bloomberg.com/*",
        "https://wsj.com/*",
        "https://*.wsj.com/*",
        "https://politico.com/*",
        "https://*.politico.com/*",
        "https://axios.com/*",
        "https://*.axios.com/*",
        "https://thehill.com/*",
        "https://*.thehill.com/*",
        "https://latimes.com/*",
        "https://*.latimes.com/*",
        "https://time.com/*",
        "https://*.time.com/*",
        "https://aljazeera.com/*",
        "https://*.aljazeera.com/*",
        "https://independent.co.uk/*",
        "https://*.independent.co.uk/*",
        "https://telegraph.co.uk/*",
        "https://*.telegraph.co.uk/*",
        "https://cbc.ca/*",
        "https://*.cbc.ca/*",
        "https://abc.net.au/*",
        "https://*.abc.net.au/*",
        "https://texastribune.org/*",
        "https://*.texastribune.org/*",
        "https://houstonchronicle.com/*",
        "https://*.houstonchronicle.com/*",
        "https://dallasnews.com/*",
        "https://*.dallasnews.com/*",
        "https://expressnews.com/*",
        "https://*.expressnews.com/*",
        "https://statesman.com/*",
        "https://*.statesman.com/*",
        "https://abcnews.go.com/*",
        "https://news.sky.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}